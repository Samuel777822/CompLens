# Copy this file to ".env" and fill it in:   cp .env.example .env   then   nano .env
# The .env file stays on your server. NEVER upload it to GitHub (.gitignore already blocks it).

# --- Website address (used by Caddy, the web server in front of the app) ---
# Start with ":80" -> the site opens at http://YOUR-SERVER-IP
# Later, with a domain pointing at the server (free: duckdns.org), put the domain here for automatic https, e.g.
#   SITE_ADDRESS=complens.duckdns.org
SITE_ADDRESS=:80

# --- Supabase (optional: the app works without it, scans just won't be logged) ---
# Only the latest 10 scans are kept (rule lives in supabase/schema.sql).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SERVICE ROLE key (or the sb_secret_... key). Backend only. Never put it in the web page or in Git.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=label-images

# --- OCR / pipeline ---
OCR_LANGS=en,hi
OCR_GPU=false
PREPROCESS=true
# Load the OCR models when the server starts, so even the first scan is fast. Keep true.
OCR_PRELOAD=true
# below these OCR confidences a result becomes REVIEW / LOW_CONFIDENCE
MIN_FIELD_CONF=0.40
MIN_OVERALL_CONF=0.45
MAX_UPLOAD_MB=10

# --- CORS (the web page and the API are on the same address, so this can stay as it is) ---
CORS_ORIGINS=*

# --- OCR passes: accuracy vs memory/speed ---
# Each photo is re-read with different clean-ups / readers until the report is clean.
#   Server with 4 GB RAM or more : OCR_MAX_PASSES=3   (best accuracy, loads two OCR models, about 3 GB RAM)
#   Server with 2 GB RAM         : OCR_MAX_PASSES=1   (loads one OCR model, about 1.5 GB RAM)
OCR_MAX_PASSES=3
OCR_EXTRA_LANGS=en
OCR_TRY_ROTATIONS=true
MAX_IMAGES=6
