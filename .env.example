# --- Supabase (optional: app works without it, scans just won't be logged) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SERVICE ROLE key. Backend only. Never put it in frontend code or commit it.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=label-images

# --- OCR / pipeline ---
OCR_LANGS=en,hi
OCR_GPU=false
PREPROCESS=true
# below these OCR confidences a result becomes REVIEW / LOW_CONFIDENCE
MIN_FIELD_CONF=0.40
MIN_OVERALL_CONF=0.45
MAX_UPLOAD_MB=10

# --- CORS (set to your frontend origin in production) ---
CORS_ORIGINS=*
